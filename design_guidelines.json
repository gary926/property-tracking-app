{
  "theme_and_archetype": {
    "domain": "Real Estate / Property Tracking (Dubai)",
    "theme": "Light",
    "archetype": "5 (Luxury) & Apple HIG Inspired",
    "mood": "Modern, Classy, Expensive, Refined",
    "color_constraint": "Strictly Blue Monochromatic System ONLY"
  },
  "colors": {
    "background": {
      "app": "#F4F7FB",
      "surface": "#FFFFFF",
      "surface_highlight": "#F8FAFC",
      "glass": "rgba(255, 255, 255, 0.85)"
    },
    "text": {
      "primary": "#0A1423",
      "secondary": "#5B6C82",
      "tertiary": "#8A9CB0",
      "inverse": "#FFFFFF",
      "price_aed": "#0F52BA"
    },
    "border": {
      "subtle": "#E2E8F0",
      "medium": "#CBD5E1",
      "focus": "#0F52BA"
    },
    "accent": {
      "primary": "#0F52BA",
      "primary_hover": "#0B3D8A",
      "primary_active": "#082B61",
      "subtle": "#E8F0FE",
      "deep": "#041B3B"
    },
    "status_system": {
      "to_view": {
        "description": "Lowest intent, outlines only",
        "type": "outline",
        "background": "#FFFFFF",
        "border": "#0F52BA",
        "text": "#0F52BA",
        "icon": "circle"
      },
      "viewed": {
        "description": "Action taken, soft fill",
        "type": "soft",
        "background": "#E8F0FE",
        "border": "transparent",
        "text": "#0F52BA",
        "icon": "eye"
      },
      "liked": {
        "description": "High intent, primary solid",
        "type": "solid",
        "background": "#0F52BA",
        "border": "transparent",
        "text": "#FFFFFF",
        "icon": "heart"
      },
      "shortlisted": {
        "description": "Highest intent, deep premium dark blue",
        "type": "solid_deep",
        "background": "#041B3B",
        "border": "transparent",
        "text": "#FFFFFF",
        "shadow": "0 4px 12px rgba(4, 27, 59, 0.3)",
        "icon": "star"
      },
      "rejected": {
        "description": "Dismissed, muted and receding",
        "type": "ghost",
        "background": "#F4F7FB",
        "border": "#E2E8F0",
        "text": "#8A9CB0",
        "decoration": "line-through",
        "icon": "x"
      }
    }
  },
  "typography": {
    "font_family": "System, -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Inter', sans-serif",
    "scale": {
      "h1_hero": { "size": "34px", "weight": "700", "tracking": "-0.04em", "line_height": "1.2" },
      "h2_title": { "size": "24px", "weight": "600", "tracking": "-0.03em", "line_height": "1.25" },
      "h3_card": { "size": "18px", "weight": "600", "tracking": "-0.02em", "line_height": "1.3" },
      "body_large": { "size": "16px", "weight": "400", "tracking": "-0.01em", "line_height": "1.5" },
      "body_sub": { "size": "14px", "weight": "400", "tracking": "0", "line_height": "1.4" },
      "caption": { "size": "12px", "weight": "500", "tracking": "0.02em", "line_height": "1.3", "text_transform": "uppercase" }
    }
  },
  "spacing_and_layout": {
    "screen_padding": "20px",
    "card_padding": "16px",
    "item_gap": "12px",
    "section_gap": "32px",
    "border_radii": {
      "small": "8px",
      "medium": "16px",
      "large": "24px",
      "pill": "9999px"
    }
  },
  "shadows_and_effects": {
    "card_base": "0 4px 20px rgba(10, 20, 35, 0.04)",
    "card_hover": "0 8px 30px rgba(10, 20, 35, 0.08)",
    "floating_button": "0 8px 24px rgba(15, 82, 186, 0.25)",
    "glass_blur": "blur(20px)"
  },
  "components": {
    "cards": {
      "background": "$colors.background.surface",
      "border_radius": "$spacing_and_layout.border_radii.large",
      "shadow": "$shadows_and_effects.card_base",
      "padding": "$spacing_and_layout.card_padding",
      "border": "1px solid $colors.border.subtle"
    },
    "buttons": {
      "primary": {
        "background": "$colors.accent.primary",
        "text": "$colors.text.inverse",
        "border_radius": "$spacing_and_layout.border_radii.pill",
        "padding": "16px 24px",
        "font_weight": "600"
      },
      "floating_action": {
        "background": "$colors.accent.deep",
        "text": "$colors.text.inverse",
        "shadow": "$shadows_and_effects.floating_button",
        "border_radius": "$spacing_and_layout.border_radii.pill",
        "size": "56px"
      }
    },
    "segmented_control": {
      "background": "#E2E8F0",
      "border_radius": "$spacing_and_layout.border_radii.medium",
      "padding": "4px",
      "active_indicator": {
        "background": "$colors.background.surface",
        "shadow": "0 2px 8px rgba(10, 20, 35, 0.08)",
        "border_radius": "$spacing_and_layout.border_radii.small",
        "text": "$colors.text.primary",
        "font_weight": "600"
      },
      "inactive_text": "$colors.text.secondary"
    },
    "bottom_tab_bar": {
      "background": "$colors.background.glass",
      "backdrop_filter": "$shadows_and_effects.glass_blur",
      "border_top": "1px solid rgba(226, 232, 240, 0.6)",
      "active_icon": "$colors.accent.primary",
      "inactive_icon": "$colors.text.tertiary"
    },
    "ios_grouped_form": {
      "background": "$colors.background.surface",
      "border_radius": "$spacing_and_layout.border_radii.medium",
      "overflow": "hidden",
      "row_border_bottom": "1px solid $colors.border.subtle",
      "padding_horizontal": "16px",
      "padding_vertical": "12px"
    }
  },
  "design_principles": [
    "Apple HIG Inspiration: Use generous white space to create a premium, uncrowded feel. Implement grouped table views for forms.",
    "Monochromatic Contrast: The blue monochrome scale must feel intentional. Pair deep navy text with bright white cards on a pale blue-grey background.",
    "No Generic Grays: All neutrals MUST be tinted with blue (e.g., #E2E8F0 has a blue undertone). Do not use pure grays or blacks.",
    "Depth and Glassmorphism: Use heavy translucency and blur (backdrop-blur-xl) for the bottom tab bar and sticky headers to create vertical depth.",
    "AED Currency: Highlight price values using the primary accent blue, keeping the typography elegant and readable."
  ],
  "testing_rules": {
    "data_testid": "MANDATORY. All interactive and informational elements MUST include a data-testid attribute using kebab-case and role-based naming (e.g., 'paste-link-button', 'status-chip-viewed', 'property-card-title')."
  }
}